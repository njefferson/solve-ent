{
  "name": "solve-ent",
  "version": "0.0.0",
  "private": true,
  "description": "Algebra-skills trainer for chemistry \u2014 domain engine and error taxonomy.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.web.json --noEmit",
    "algebra": "node tools/verify-algebra.mjs",
    "version:check": "node tools/version-check.mjs",
    "copy": "node tools/copy-check.mjs",
    "notes": "node tools/changelog.mjs",
    "notes:check": "node tools/changelog.mjs --check",
    "cli": "node tools/cli.ts",
    "check": "npm run typecheck && npm run coverage && npm run version:check && npm run pin && npm run palette:check && npm run web:check && npm run icon:check && npm run pwa:check && npm run notes:check && npm run copy && npm test && npm run algebra",
    "gates": "node ../noahjefferson/branch-guard.mjs --repo . && node ../noahjefferson/privacy-check.mjs --repo . && node ../noahjefferson/quote-check.mjs --repo . && node ../noahjefferson/docs-check.mjs . && node ../noahjefferson/pin-check.mjs --repo .",
    "doctrine": "node ../noahjefferson/doctrine-sync.mjs --repo .",
    "branch": "node ../noahjefferson/branch-guard.mjs --repo .",
    "prepare": "node ../noahjefferson/branch-guard.mjs --repo . --install >/dev/null 2>&1 || true",
    "pin": "node tools/hub-pin-check.mjs",
    "palette": "node tools/palette.mjs",
    "palette:check": "node tools/palette.mjs --check",
    "web": "node tools/web-build.mjs",
    "web:check": "node tools/web-build.mjs --check",
    "icon:check": "node tools/icon.mjs --check",
    "a11y": "node tools/a11y.mjs",
    "coverage": "node tools/coverage-check.mjs",
    "walk": "node tools/walk.mjs",
    "browser": "npm run a11y && npm run fold && npm run walk && npm run update-walk",
    "fold": "node tools/fold-check.mjs",
    "pwa": "node tools/pwa.mjs",
    "pwa:check": "node tools/pwa.mjs --check",
    "update-walk": "node tools/update-walk.mjs",
    "generate": "npm run palette && npm run notes && npm run web && npm run pwa"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "axe-core": "4.12.1",
    "playwright": "1.56.1",
    "typescript": "7.0.2"
  }
}
